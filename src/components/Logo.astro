---
interface Props {
	class?: string;
	light?: boolean;
}
const { class: className, light = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
	<svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
		<rect width="32" height="32" rx="8" fill={light ? '#ffffff' : '#14213d'}></rect>
		<rect x="7" y="9" width="12" height="3.2" rx="1.6" fill="#ff8f8f"></rect>
		<rect x="7" y="14.4" width="18" height="3.2" rx="1.6" fill={light ? '#14213d' : '#ffffff'} opacity="0.35"></rect>
		<rect x="7" y="19.8" width="15" height="3.2" rx="1.6" fill="#f97316"></rect>
	</svg>
	<span class:list={['text-[1.4rem] leading-none font-extrabold tracking-[-0.04em]', light ? 'text-white' : 'text-ink']}
		>sulih</span
	>
</span>
