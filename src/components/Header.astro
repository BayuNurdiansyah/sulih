---
import { NAV, waLink } from '../consts';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="border-b border-line bg-paper">
	<div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3.5">
		<a href="/" class="no-underline" aria-label="Sulih, kembali ke beranda">
			<Logo />
		</a>
		<nav aria-label="Navigasi utama" class="order-3 w-full md:order-2 md:w-auto">
			<ul class="-mx-2 flex gap-1 overflow-x-auto text-[0.98rem] font-semibold">
				{
					NAV.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={isActive(item.href) ? 'page' : undefined}
								class:list={[
									'block rounded-md px-2.5 py-2 whitespace-nowrap no-underline hover:bg-mist',
									isActive(item.href) ? 'text-orange-deep' : 'text-ink-soft',
								]}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<a
			href={waLink()}
			class="btn btn-primary order-2 min-h-0 px-4 py-2.5 text-[0.95rem] md:order-3"
			rel="noopener noreferrer"
			target="_blank">Konsultasi gratis</a
		>
	</div>
</header>
