---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
	title="Blog Sulih: Panduan Migrasi dan Perawatan Aplikasi PHP"
	description="Artikel praktis seputar migrasi PHP native dan CodeIgniter ke Laravel, keamanan aplikasi PHP lama, dan perawatan sistem web untuk sekolah, UMKM, dan koperasi."
>
	<section class="wrap pt-12 md:pt-20">
		<h1 class="max-w-3xl">Blog Sulih</h1>
		<p class="lead mt-5 measure">
			Panduan praktis untuk pemilik dan pengelola aplikasi PHP lama: kapan perlu migrasi, bagaimana caranya, dan risiko yang
			perlu diantisipasi.
		</p>
		<ul class="mt-12 max-w-4xl divide-y divide-line border-y border-line">
			{
				posts.map((post) => (
					<li class="py-7">
						<a href={`/blog/${post.id}/`} class="group block no-underline">
							<h2 class="text-[1.5rem] group-hover:text-orange-deep group-hover:underline">{post.data.title}</h2>
							<p class="mt-2 text-ink-soft">{post.data.description}</p>
							<p class="mt-2 text-sm text-ink-faint">
								<FormattedDate date={post.data.pubDate} />
							</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>
