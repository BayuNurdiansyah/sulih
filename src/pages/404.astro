---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LANDING_PATH } from '../consts';
---

<BaseLayout
	title="Halaman Tidak Ditemukan | Sulih"
	description="Halaman yang Anda cari tidak ada di situs Sulih. Kembali ke beranda atau lihat layanan migrasi PHP ke Laravel."
	noindex
>
	<section class="wrap pt-16 md:pt-24">
		<p class="font-mono text-ink-faint">404</p>
		<h1 class="mt-2 max-w-2xl">Halaman ini tidak ditemukan</h1>
		<p class="lead mt-5 measure">Alamatnya mungkin salah ketik atau halamannya sudah dipindahkan.</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<a href="/" class="btn btn-primary">Kembali ke beranda</a>
			<a href={LANDING_PATH} class="btn btn-ghost">Lihat layanan migrasi</a>
		</div>
	</section>
</BaseLayout>
